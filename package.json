{
  "name": "douyin-live-wall",
  "version": "1.4.1",
  "private": true,
  "main": "mini-app/main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:mini": "node --test tests/live-platform.test.js tests/platform-grid.test.js tests/platform-windows.test.js tests/room-search.test.js tests/xiaohongshu-audience.test.js tests/xiaohongshu-stream.test.js tests/xiaohongshu-tracker.test.js tests/xiaohongshu-desktop.test.js tests/live-presence.test.js tests/recording-settings.test.js tests/auto-recorder.test.js tests/mini-app-recording-ui.test.js tests/douyin-stream.test.js tests/room-refresh.test.js",
    "dist:mac": "electron-builder --mac --arm64 --x64",
    "dist:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.1",
    "pako": "^3.0.0"
  },
  "build": {
    "appId": "com.jinhe.douyinwall",
    "productName": "抖音多宫格直播墙",
    "executableName": "DouyinLiveWall",
    "artifactName": "DouyinLiveWall-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "JinHe9527",
        "repo": "douyin-live-wall"
      }
    ],
    "files": [
      "mini-app/**/*",
      "lib/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist-mini",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.video",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "抖音多宫格直播墙"
    }
  },
  "description": "团播多平台直播墙，支持抖音和小红书名称搜索、在线人数、多路观看与录制",
  "author": "JinHe9527",
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
